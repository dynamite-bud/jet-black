# {{ scheme-name }} — Catppuccin-compatible @thm_* palette
# Scheme author: {{ scheme-author }}
#
# For tmux status bars built on catppuccin/tmux variable names. Source this
# AFTER catppuccin loads to override its palette with jet-black (uses `set -g`,
# not catppuccin's only-if-unset `-ogq`, so it wins). See jet-black wiring.

set -g @thm_bg "#{{ base00-hex }}"
set -g @thm_fg "#{{ base05-hex }}"
set -g @thm_red "#{{ base08-hex }}"
set -g @thm_maroon "#{{ base08-hex }}"
# UI fills (active window bg, last-window fg) use a DEEPER orange than the neon
# syntax orange (base09 #{{ base09-hex }}) — a bright fill glares on pure black.
set -g @thm_peach "#d9731f"
set -g @thm_orange "#d9731f"
set -g @thm_yellow "#{{ base0A-hex }}"
set -g @thm_green "#{{ base0B-hex }}"
set -g @thm_teal "#{{ base0C-hex }}"
set -g @thm_sky "#{{ base0C-hex }}"
set -g @thm_blue "#{{ base0D-hex }}"
set -g @thm_sapphire "#{{ base0D-hex }}"
set -g @thm_lavender "#{{ base0D-hex }}"
set -g @thm_mauve "#{{ base0E-hex }}"
set -g @thm_pink "#{{ base0E-hex }}"
set -g @thm_flamingo "#{{ base08-hex }}"
set -g @thm_rosewater "#{{ base06-hex }}"
# Surfaces / overlays (mono ramp)
set -g @thm_surface_0 "#{{ base02-hex }}"
set -g @thm_surface_1 "#{{ base03-hex }}"
set -g @thm_surface_2 "#{{ base04-hex }}"
set -g @thm_overlay_0 "#{{ base03-hex }}"
set -g @thm_overlay_1 "#{{ base04-hex }}"
set -g @thm_overlay_2 "#{{ base04-hex }}"

# Subtle window status (dark-only): the active window is a dark-grey fill with a
# bold colored number — no bright fill that glares on pure black. The last-active
# window goes neutral grey (kills the floating orange number). Overrides the
# catppuccin-style window status from .tmux.conf, so source this AFTER it.
set -g window-status-current-style "bg=#{{ base02-hex }},fg=#{{ base0D-hex }},bold"
set -g window-status-last-style "bg=default,fg=#{{ base04-hex }}"
