# {{ scheme-name }} — Atuin theme
# Scheme author: {{ scheme-author }}
# Install: copy to ~/.config/atuin/themes/jet-black.toml, then in config.toml:
#   [theme]
#   name = "jet-black"

[theme]
name = "{{ scheme-slug }}"

[colors]
Base      = "#{{ base05-hex }}"
Title     = "#{{ base0D-hex }}"
Important = "#{{ base09-hex }}"
Guidance  = "#{{ base04-hex }}"
Annotation = "#{{ base03-hex }}"
AlertInfo  = "#{{ base0B-hex }}"
AlertWarn  = "#{{ base0A-hex }}"
AlertError = "#{{ base08-hex }}"
